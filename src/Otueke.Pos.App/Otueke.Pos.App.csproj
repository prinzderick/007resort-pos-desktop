<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows restore/build of Windows-targeted projects on macOS/Linux dev machines; CI builds on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Otueke.Pos.App</RootNamespace>
    <AssemblyName>Otueke.Pos</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Otueke.Pos.Core\Otueke.Pos.Core.csproj" />
    <ProjectReference Include="..\Otueke.Pos.Devices\Otueke.Pos.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
