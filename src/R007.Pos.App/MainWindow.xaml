<Window x:Class="R007.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmroot="clr-namespace:R007.Pos.ViewModels;assembly=R007.Pos.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vmroot:ShellViewModel}"
        Title="007 Resort &amp; Spa POS"
        Background="{StaticResource BgBrush}"
        WindowState="Maximized"
        MinWidth="1024" MinHeight="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar: who/where, connectivity, emergency queue -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="007 Resort &amp; Spa POS" FontWeight="Bold" Margin="0,0,16,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding FacilityName}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                <Border DockPanel.Dock="Left" Background="{StaticResource WarnBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,16,0"
                        Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DEMO MODE (mock server)" Foreground="Black" FontWeight="Bold" />
                </Border>
                <Button DockPanel.Dock="Right" Content="Sign out" Command="{Binding SignOutCommand}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StaffName}" FontWeight="SemiBold" Margin="12,0" />
                <Border DockPanel.Dock="Right" Background="{StaticResource DangerBrush}" CornerRadius="10" Padding="10,2" Margin="12,0"
                        Visibility="{Binding HasCollectionsBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CollectionsBadgeLabel}" FontWeight="Bold" />
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PendingText}" Foreground="{StaticResource WarnBrush}" FontWeight="Bold" Margin="12,0"
                           Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectivityText}" Margin="12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                    <Setter Property="Foreground" Value="#FFFF8A80" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource WarnBrush}" Padding="12,8"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Banner}" Foreground="Black" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding Current}" IsTabStop="False" />

        <!-- Modal dialogs (payment, supervisor approval, lookup...) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding HasModal, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Background="{StaticResource PanelBrush}" MaxWidth="900" MaxHeight="820"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <ContentControl Content="{Binding TopModal}" IsTabStop="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
