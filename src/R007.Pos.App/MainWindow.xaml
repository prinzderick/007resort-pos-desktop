<Window x:Class="R007.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="007 Resort &amp; Spa POS"
        Width="1024"
        Height="768"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FF1E1E24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText"
                       FontSize="32"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Text="007 Resort &amp; Spa POS — not registered" />
            <TextBlock x:Name="ApiText"
                       Margin="0,16,0,0"
                       FontSize="14"
                       Foreground="#FFB0B0B8"
                       HorizontalAlignment="Center"
                       Text="Contacting API…" />
        </StackPanel>
    </Grid>
</Window>
