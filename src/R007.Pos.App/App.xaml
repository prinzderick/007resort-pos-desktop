<Application x:Class="R007.Pos.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             xmlns:views="clr-namespace:R007.Pos.App.Views"
             xmlns:infra="clr-namespace:R007.Pos.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: dark, high contrast, readable at arm's length on a till -->
            <Color x:Key="BgColor">#FF15181D</Color>
            <Color x:Key="PanelColor">#FF20252D</Color>
            <Color x:Key="PanelAltColor">#FF2A313B</Color>
            <Color x:Key="AccentColor">#FF2E9E6B</Color>
            <Color x:Key="DangerColor">#FFC0392B</Color>
            <Color x:Key="WarnColor">#FFE0A030</Color>
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFECEFF4" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA4B2" />

            <infra:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
            <infra:NullToVisibilityConverter x:Key="NullToVis" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFF8A80" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#FF3A4350" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#FF3A4350" />
            </Style>

            <!-- Touch-sized buttons (>= 48 px) -->
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="BorderBrush" Value="#FF3A4350" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            </Style>

            <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="96" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinHeight" Value="44" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="6" />
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- View model -> view mapping. Which screens exist is decided by the view models (capabilities + permissions). -->
            <DataTemplate DataType="{x:Type vm:SetupViewModel}"><views:SetupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainViewModel}"><views:MainView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SellViewModel}"><views:SellView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TablesViewModel}"><views:TablesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReceptionViewModel}"><views:ReceptionView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ApprovalsInboxViewModel}"><views:ApprovalsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashSessionViewModel}"><views:CashSessionView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:QueueViewModel}"><views:QueueView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}"><views:PaymentDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SensitiveActionViewModel}"><views:SensitiveActionView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerLookupViewModel}"><views:CustomerLookupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OpenTabViewModel}"><views:OpenTabView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
