<UserControl x:Class="R007.Pos.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionViewModel}">
    <StackPanel Width="560">
        <TextBlock Style="{StaticResource Heading}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding CurrentText, StringFormat='This terminal is using {0}'}" Margin="0,0,0,10" />
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,0,0,8"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Muted}" Text="Enter the connection PIN to change server." Margin="0,0,0,6" />
            <PasswordBox x:Name="PinBox" PasswordChanged="OnPinChanged" />
            <Button Style="{StaticResource PrimaryButton}" Content="Unlock" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Each server keeps its own enrolment and sign-in, so switching back later needs no new registration code. You will be signed out." />
            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ServerChoice}">
                        <Button HorizontalContentAlignment="Stretch" Padding="14,10" Margin="0,0,0,6"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding UrlText}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Another server" Style="{StaticResource Muted}" Margin="0,10,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Use this address" Command="{Binding UseNewCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>

        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
