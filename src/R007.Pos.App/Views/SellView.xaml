<UserControl x:Class="R007.Pos.App.Views.SellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SellViewModel}"
             Loaded="OnLoaded">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- Left: category tabs, search / scan, touch grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryChip}">
                        <Button Content="{Binding Name}" MinWidth="110"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="1" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource Muted}" Text="Search items" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0" Visibility="{Binding ShowBarcodeBox, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Muted}" Text="Scan barcode / SKU (then Enter)" />
                    <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ScanCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickNotes}" Margin="4,6,4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" MinHeight="36" FontSize="13"
                                Command="{Binding DataContext.ToggleNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding VisibleProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductTile}">
                            <Button Style="{StaticResource TileButton}"
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PriceText}" TextAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right: cart (every figure is the server's) -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding TargetLabel}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding OrderNumberText}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding TabBalanceText}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                               Visibility="{Binding IsTabTarget, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StateChipsText}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="{Binding HasStateChips, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding BillText}" Style="{StaticResource Muted}" Visibility="{Binding IsBilled, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource WarnBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Visibility="{Binding HasOpenOrders, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <TextBlock Text="Open orders here (tap to load)" Style="{StaticResource Muted}" />
                        <ItemsControl ItemsSource="{Binding OpenOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OpenOrderRow}">
                                    <Button HorizontalContentAlignment="Stretch" MinHeight="40" FontSize="14"
                                            Command="{Binding DataContext.SelectOpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding ChipsText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"
                                                       Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,4"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Info}" Margin="0,4"
                               Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Lines}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CartLineViewModel}">
                            <Border BorderBrush="#FF3A4350" BorderThickness="0,0,0,1" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="-" MinWidth="44" MinHeight="40"
                                                    Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Quantity}" FontSize="18" FontWeight="Bold" Margin="8,0" MinWidth="24" TextAlignment="Center" />
                                            <Button Content="+" MinWidth="44" MinHeight="40"
                                                    Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Discount" MinHeight="36" FontSize="13"
                                                    Command="{Binding DataContext.DiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDiscount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Comp" MinHeight="36" FontSize="13"
                                                    Command="{Binding DataContext.CompCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanComp, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Price" MinHeight="36" FontSize="13"
                                                    Command="{Binding DataContext.PriceOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanPriceOverride, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LineTotalText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <Button Content="Remove" MinHeight="36" FontSize="13" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEditLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <DockPanel><TextBlock Text="Subtotal" Style="{StaticResource Muted}" /><TextBlock Text="{Binding SubtotalText}" HorizontalAlignment="Right" /></DockPanel>
                    <DockPanel><TextBlock Text="Discount" Style="{StaticResource Muted}" /><TextBlock Text="{Binding DiscountText}" HorizontalAlignment="Right" /></DockPanel>
                    <DockPanel><TextBlock Text="Tax" Style="{StaticResource Muted}" /><TextBlock Text="{Binding TaxText}" HorizontalAlignment="Right" /></DockPanel>
                    <DockPanel><TextBlock Text="TOTAL" FontSize="22" FontWeight="Bold" /><TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" TextWrapping="Wrap" /></DockPanel>
                    <TextBlock Text="{Binding BalanceText}" HorizontalAlignment="Right" Foreground="{StaticResource WarnBrush}" />
                </StackPanel>

                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                    <Button Content="Send" Command="{Binding SendCommand}" />
                    <Button Content="Mark served" Command="{Binding ServeCommand}" />
                    <Button Content="Print bill" Command="{Binding PrintBillCommand}" />
                    <Button Content="Reopen bill" Command="{Binding ReopenBillCommand}" Visibility="{Binding IsBilled, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Pay" Command="{Binding PayCommand}" MinWidth="110" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Settle tab" Command="{Binding SettleTabCommand}"
                            Visibility="{Binding IsTabTarget, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource DangerButton}" Content="Void order" Command="{Binding VoidCommand}" />
                    <Button Content="New order" Command="{Binding NewOrderCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
