<UserControl x:Class="R007.Pos.App.Views.CustomerLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomerLookupViewModel}">
    <StackPanel MinWidth="560">
        <TextBlock Style="{StaticResource Heading}" Text="{Binding Title}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <ListBox ItemsSource="{Binding Results}" MinHeight="180" MaxHeight="320" Margin="0,8" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding HolderName}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{Binding Number, Mode=OneWay}" /> <Run Text="{Binding Status, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Style="{StaticResource Muted}" Text="{Binding Info}" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" />
    </StackPanel>
</UserControl>
