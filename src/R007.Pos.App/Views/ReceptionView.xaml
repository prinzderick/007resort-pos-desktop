<UserControl x:Class="R007.Pos.App.Views.ReceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             xmlns:api="clr-namespace:R007.Pos.Core.Api;assembly=R007.Pos.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceptionViewModel}">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="What to book" />
                <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding Resource}" DisplayMemberPath="Name" FontSize="18" />
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="&lt;" Command="{Binding PreviousDayCommand}" MinWidth="56" />
                    <TextBlock Text="{Binding DayText}" FontSize="20" FontWeight="Bold" Margin="12,0" />
                    <Button Content="&gt;" Command="{Binding NextDayCommand}" MinWidth="56" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="People:" Margin="0,0,8,0" />
                    <Button Content="-" Command="{Binding DecreasePartyCommand}" MinWidth="48" />
                    <TextBlock Text="{Binding PartySize}" FontSize="20" FontWeight="Bold" Margin="8,0" />
                    <Button Content="+" Command="{Binding IncreasePartyCommand}" MinWidth="48" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SlotRow}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Availability}" />
                                <TextBlock Grid.Column="2" Text="{Binding PriceText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Booking" />
                    <TextBlock Text="Customer name" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Find a member" Command="{Binding LookupMemberCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MemberText}" Style="{StaticResource Muted}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="Hold this slot" Command="{Binding HoldCommand}" Margin="4,12,4,4" />

                    <StackPanel Visibility="{Binding HasBooking, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BookingText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Margin="0,8" />
                        <TextBlock Text="Add equipment rental" Style="{StaticResource Muted}" />
                        <ItemsControl ItemsSource="{Binding Rentals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RentalRow}">
                                    <Button HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.AddRentalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource PrimaryButton}" Content="Take payment and print QR ticket" Command="{Binding PayCommand}" MinHeight="60" Margin="4,12,4,4" />
                        <Button Content="Release hold" Command="{Binding CancelHoldCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Info}" Margin="0,12,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
