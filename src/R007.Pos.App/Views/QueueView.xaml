<UserControl x:Class="R007.Pos.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             xmlns:api="clr-namespace:R007.Pos.Core.Api;assembly=R007.Pos.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QueueViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Heading}" Text="Emergency queue" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="When the server cannot be reached, cash payments and orders can be saved here (encrypted) and are sent in order when the connection returns. Items are NOT confirmed until the server accepts them." />
            <TextBlock Text="{Binding SummaryText}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="{Binding BlockedText}" Foreground="#FFFF8A80" FontWeight="Bold" TextWrapping="Wrap"
                       Visibility="{Binding BlockedText, Converter={StaticResource NullToVis}}" />
            <TextBlock Text="Local queue data was damaged and part of it could not be read. Tell IT; nothing readable was lost." Foreground="#FFFF8A80" TextWrapping="Wrap"
                       Visibility="{Binding CorruptionDetected, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Send now" Command="{Binding DrainCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Info}" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="Waiting to be confirmed" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Margin="0,2" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Refused by the server (needs a person)" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ItemsControl ItemsSource="{Binding Rejected}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RejectedRow}">
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Seen" Command="{Binding AcknowledgeCommand}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason}" Foreground="#FFFF8A80" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
