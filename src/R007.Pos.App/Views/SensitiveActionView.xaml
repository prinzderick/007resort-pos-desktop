<UserControl x:Class="R007.Pos.App.Views.SensitiveActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:R007.Pos.ViewModels.Screens;assembly=R007.Pos.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SensitiveActionViewModel}">
    <StackPanel MinWidth="560">
        <TextBlock Style="{StaticResource Heading}" Text="{Binding Title}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

        <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource InvBoolToVis}}">
            <StackPanel Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding ValueLabel}" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxWidth="260" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Visibility="{Binding NeedsReason, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Reason (recorded in the audit trail)" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <CheckBox Content="A supervisor is here: they sign in on this terminal to authorise now" IsChecked="{Binding SupervisorHere}" Margin="0,14,0,4" />
            <StackPanel Visibility="{Binding SupervisorHere, Converter={StaticResource BoolToVis}}" Margin="0,4">
                <TextBlock Text="Supervisor staff number" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding SupervisorNumber, UpdateSourceTrigger=PropertyChanged}" MaxWidth="300" HorizontalAlignment="Left" />
                <TextBlock Text="Supervisor PIN" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <PasswordBox x:Name="SupervisorPinBox" MaxWidth="300" HorizontalAlignment="Left" PasswordChanged="OnPinChanged" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                       Text="Otherwise the request is sent to the supervisors on the floor and this screen waits for their decision."
                       Visibility="{Binding SupervisorHere, Converter={StaticResource InvBoolToVis}}" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}" Margin="0,8">
            <ProgressBar IsIndeterminate="True" Height="10" Margin="0,0,0,10" />
            <TextBlock Text="{Binding WaitStatus}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Submit" Command="{Binding SubmitCommand}" MinWidth="160" MinHeight="56" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="120" MinHeight="56" />
        </StackPanel>
    </StackPanel>
</UserControl>
